data:Q69
    a schema:Dataset,
        dcat:Dataset ;
    cc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The Vlasto Cat. records the above coins as from the Taranto 1908 hd. (Noe 1051 = no. 2000); that hd., however, contained nothing but Taras, Per. VIII. Nos. 413-5 are recorded as from &#x022;the 1908 Taranto find (Ionian Shore find). Noe 1051.&#x022; It is evident that there is a confusion between two finds made in the same year, but concealed at very different dates. In his copy of J. Hirsch May 23, 1910 Evans noted &#x022;Hirsch Find&#x022; against Thurium nos. 281, 285-91, 294, 296 and Corcyra no. 496."@en ;
    dcterms:identifier "Q69" ;
    dcterms:isPartOf cat:items ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2023-08-14T15:11:22Z"^^xsd:dateTime ;
